<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prompt shown to learner (Khmer)"
        app:placeholderText="ខ្ញុំបានទៅផ្សារ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKhmerPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Correct English sentence"
        app:placeholderText="I went to the market">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCorrectSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Word tiles (learner sees them shuffled)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- Hint shown while the sentence is empty -->
    <TextView
        android:id="@+id/tvTilesHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tiles appear as you type."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- One non-clickable Chip per word, added in code -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp" />
</LinearLayout>